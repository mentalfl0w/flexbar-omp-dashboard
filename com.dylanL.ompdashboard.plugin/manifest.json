{
  "name": "OMP Dashboard",
  "uuid": "com.dylanL.ompdashboard",
  "version": "1.0.0",
  "author": "Dylan Liu",
  "entry": "backend/plugin.cjs",
  "description": "Display oh-my-pi (OMP) LLM usage statistics on Flexbar: token consumption, cost, model distribution, agent activity, and live monitoring.",
  "repo": "",
  "configPage": "",
  "platform": [
    "mac",
    "windows",
    "linux"
  ],
  "keyLibrary": {
    "title": "OMP Dashboard",
    "style": {
      "icon": "mdi mdi-chart-line"
    },
    "children": [
      {
        "title": "$OverviewStrip.Title",
        "tip": "$OverviewStrip.Tip",
        "cid": "com.dylanL.ompdashboard.overviewstrip",
        "config": {
          "keyType": "directDraw",
          "clickable": true,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-chart-line",
          "width": 240
        },
        "data": {}
      },
      {
        "title": "$Today.Title",
        "tip": "$Today.Tip",
        "cid": "com.dylanL.ompdashboard.today",
        "config": {
          "keyType": "standard",
          "clickable": true,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-calendar-today",
          "width": 320
        },
        "data": {}
      },
      {
        "title": "$SevenDay.Title",
        "tip": "$SevenDay.Tip",
        "cid": "com.dylanL.ompdashboard.sevenday",
        "config": {
          "keyType": "standard",
          "clickable": true,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-chart-line-variant",
          "width": 480
        },
        "data": {}
      },
      {
        "title": "$Models.Title",
        "tip": "$Models.Tip",
        "cid": "com.dylanL.ompdashboard.models",
        "config": {
          "keyType": "dynamic",
          "clickable": false,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-format-list-bulleted",
          "width": 240
        },
        "data": {
          "subkeyNum": 0
        }
      },
      {
        "title": "$Agents.Title",
        "tip": "$Agents.Tip",
        "cid": "com.dylanL.ompdashboard.agents",
        "config": {
          "keyType": "standard",
          "clickable": true,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-account-group",
          "width": 320
        },
        "data": {}
      },
      {
        "title": "$Recent.Title",
        "tip": "$Recent.Tip",
        "cid": "com.dylanL.ompdashboard.recent",
        "config": {
          "keyType": "dynamic",
          "clickable": false,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-history",
          "width": 240
        },
        "data": {
          "subkeyNum": 0
        }
      },
      {
        "title": "$Live.Title",
        "tip": "$Live.Tip",
        "cid": "com.dylanL.ompdashboard.live",
        "config": {
          "keyType": "standard",
          "clickable": true,
          "platform": [
            "mac",
            "windows",
            "linux"
          ]
        },
        "style": {
          "icon": "mdi mdi-pulse",
          "width": 480
        },
        "data": {}
      }
    ]
  },
